# ================================================================
# CompliSure - Environment Configuration
# ================================================================

# Google Gemini API Key (Server-side only)
GEMINI_API_KEY=

# Gemini LLM and Embedding Models
GEMINI_MODEL=gemini-3.7-flash
EMBEDDING_MODEL=text-embedding-004

# Safeguard Default Configuration
DEFAULT_SAFEGUARD_MODE=rag_threshold_verification
DEFAULT_EVIDENCE_THRESHOLD=0.75
DEFAULT_TOP_K=5
MIN_SUPPORTING_CHUNKS=1

# Document Chunking Settings
CHUNK_SIZE=400
CHUNK_OVERLAP=50

# Verification Policies
REQUIRE_SOURCE_CITATION=true
ENABLE_ANSWER_VERIFICATION=true
ALLOW_UNSUPPORTED_ANSWERS=false

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=false
